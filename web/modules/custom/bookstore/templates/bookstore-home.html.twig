<div id="bookstore-carousel" class="carousel slide bookstore-carousel" data-bs-ride="carousel">
  <div class="carousel-inner">
    <div class="carousel-item active"><img src="{{ theme_path }}/images/img-book-of-year.jpeg" alt="Libro del año"></div>
    <div class="carousel-item"><img src="{{ theme_path }}/images/img-new-releases.jpeg" alt="Novedades editoriales"></div>
  </div>
  <button class="carousel-control-prev" type="button" data-bs-target="#bookstore-carousel" data-bs-slide="prev" aria-label="Anterior"><span class="carousel-control-prev-icon"></span></button>
  <button class="carousel-control-next" type="button" data-bs-target="#bookstore-carousel" data-bs-slide="next" aria-label="Siguiente"><span class="carousel-control-next-icon"></span></button>
</div>
<section class="my-5"><h2 class="mb-4">Los Más Vendidos</h2><div class="row">
  {% for book in books %}
    <div class="col-12 col-md-6 col-lg-4 col-xl-3 mb-4"><article class="card my-3 p-3 rounded shadow-sm h-100 book-card">
      <a href="{{ book.url }}"><img class="card-img-top" src="{{ book.image_url }}" alt="Portada de {{ book.title }}"></a>
      <div class="card-body d-flex flex-column"><a class="text-decoration-none" href="{{ book.url }}"><h3 class="card-title h5">{{ book.title }}</h3></a><p class="text-secondary small mb-2">{{ book.author }}</p><p class="mb-0 fw-semibold">${{ book.price_display }}</p></div>
    </article></div>
  {% else %}<p>No hay libros disponibles.</p>{% endfor %}
</div></section>
