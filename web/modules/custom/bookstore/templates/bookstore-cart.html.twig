<h1>Carrito de compras</h1>
{% if items %}<div class="row"><div class="col-md-8"><div class="list-group list-group-flush">{% for item in items %}<div class="list-group-item"><div class="row align-items-center"><div class="col-md-2"><img class="img-fluid rounded" src="{{ item.image_url }}" alt="Portada de {{ item.title }}"></div><div class="col-md-4"><a href="{{ item.url }}">{{ item.title }}</a></div><div class="col-md-2">${{ item.price_display }}</div><div class="col-md-4">{{ item.update_form }}</div></div></div>{% endfor %}</div></div><div class="col-md-4"><div class="list-group"><div class="list-group-item"><h2 class="h4">Resumen</h2></div><div class="list-group-item"><strong>Productos:</strong> {{ count }}</div><div class="list-group-item"><strong>Subtotal:</strong> ${{ subtotal }}</div><div class="list-group-item">{{ checkout }}</div></div></div></div>
{% else %}<p>Tu carrito está vacío. <a href="{{ path('bookstore.home') }}">Regresar al catálogo</a></p>{% endif %}
