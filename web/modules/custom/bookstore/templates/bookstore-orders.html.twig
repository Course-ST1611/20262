<h1>Mis compras</h1>{% if orders %}<div class="accordion" id="orders-list">{% for order in orders %}<div class="accordion-item"><h2 class="accordion-header"><button class="accordion-button collapsed" type="button" data-bs-toggle="collapse" data-bs-target="#order-{{ loop.index }}" aria-expanded="false">{{ order.date_display }} — Orden {{ order.order_id }} — {{ order.quantity }} productos — ${{ order.total_display }} — {{ order.order_status }}</button></h2><div class="accordion-collapse collapse" id="order-{{ loop.index }}"><div class="accordion-body"><div class="table-responsive"><table class="table table-hover"><thead><tr><th>LIBRO</th><th>ISBN</th><th>CANTIDAD</th><th>PRECIO</th><th>TOTAL</th></tr></thead><tbody>{% for item in order.items %}<tr><td>{{ item.title }}<br><small>{{ item.author }}</small></td><td>{{ item.isbn }}</td><td>{{ item.quantity }}</td><td>${{ item.unit_display }}</td><td>${{ item.line_display }}</td></tr>{% endfor %}</tbody></table></div><p class="text-end"><strong>Total de la compra: ${{ order.total_display }}</strong></p></div></div></div>{% endfor %}</div>{% else %}<div class="alert alert-light">Aún no tienes compras registradas.</div>{% endif %}
