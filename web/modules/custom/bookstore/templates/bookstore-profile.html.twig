<h1>Mi perfil</h1><div class="row justify-content-center"><div class="col-md-10"><div class="card shadow rounded-4 p-4"><div class="card-body"><h2>{{ customer.first_name }} {{ customer.last_name }}</h2><ul class="list-group list-group-flush"><li class="list-group-item"><strong>Email:</strong> {{ customer.email }}</li><li class="list-group-item"><strong>Ciudad:</strong> {{ customer.city ?: 'No registrada' }}</li><li class="list-group-item"><strong>País:</strong> {{ customer.country ?: 'No registrado' }}</li></ul></div></div></div></div>
